{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crisis-in-gordistan",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ws/*"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAMES",
        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "GameDirectory"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GameDirectory"
      ]
    }
  ]
}
